# P10-S01: NON-secret production settings for docker-compose.prod.yml.
# Copy to .env.production (git-ignored). Secrets (database password, signing
# keys, SMTP/ABDM secrets) do NOT go here - they live in ./secrets/ (see
# backend/scripts/generate_secrets.py).

# Public host name served by nginx. Required. No scheme, no port.
HIS_DOMAIN=his.example-hospital.org

# Directory holding fullchain.pem and privkey.pem for HIS_DOMAIN (absolute path).
HIS_TLS_DIR=/etc/his/tls

# Optional overrides
# HIS_HTTP_PORT=80
# HIS_HTTPS_PORT=443
# HIS_NETWORK_SUBNET=172.30.88.0/24   # the compose network nginx lives on; the API trusts only this range
# POSTGRES_USER=his_app
# POSTGRES_DB=his

# Email for activation / password-reset links (password -> secrets/smtp_password)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USERNAME=mailer
# SMTP_FROM=no-reply@example-hospital.org

# ABDM (client secret -> secrets/abdm_client_secret)
# ABDM_ADAPTER=sandbox
# ABDM_CLIENT_ID=
