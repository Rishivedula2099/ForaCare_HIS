ENVIRONMENT=local
DEBUG=true
APP_NAME=ForaCare HIS API
API_V1_PREFIX=/api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database
DATABASE_URL=postgresql+asyncpg://forahis:forahis@localhost:5432/forahis
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
