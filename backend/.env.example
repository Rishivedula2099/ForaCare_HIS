ENVIRONMENT=local
DEBUG=true
APP_NAME=ForaCare HIS API
API_V1_PREFIX=/api/v1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database
DATABASE_URL=postgresql+asyncpg://forahis:forahis@localhost:5433/forahis
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Auth / JWT - generate distinct real secrets for non-local environments, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_SECRET_KEY=local-dev-only-insecure-access-secret-change-me
JWT_REFRESH_SECRET_KEY=local-dev-only-insecure-refresh-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3

# Auth cookies - leave COOKIE_DOMAIN unset for localhost; secure flag is
# forced on automatically outside ENVIRONMENT=local.
COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax

# OTP (email/phone change verification)
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
