# P10-S01: production edge. Rendered by the nginx image's entrypoint
# (envsubst) into /etc/nginx/conf.d/default.conf; HIS_DOMAIN is the public host
# name. Everything here lives in the http{} context.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

include /etc/nginx/trusted_proxies.conf;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# (keepalive_timeout, server_tokens and the stock access_log are set by the image's
# nginx.conf; the stock access_log logs full request lines, so each server below
# overrides it with the query-string-free `his` format.)
log_format his '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent '
               '"$http_user_agent" rt=$request_time';
# $uri, not $request: query strings carry patient searches and QR signatures

# Request limits ------------------------------------------------------------------
client_max_body_size 1m;            # default; uploads get their own limit below
client_header_timeout 15s;          # slow-loris
client_body_timeout 30s;
send_timeout 30s;
large_client_header_buffers 4 8k;

limit_req_zone  $binary_remote_addr zone=his_general:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=his_auth:10m    rate=5r/s;
limit_req_zone  $binary_remote_addr zone=his_public:10m  rate=2r/s;
limit_conn_zone $binary_remote_addr zone=his_conn:10m;
limit_req_status 429;
limit_conn_status 429;
limit_conn his_conn 50;

upstream his_frontend { server frontend:3000; }
upstream his_backend  { server backend:8000; }

# Plain HTTP: nothing but the ACME challenge and a redirect ---------------------
server {
    listen 80;
    server_name ${HIS_DOMAIN};
    access_log /dev/stdout his;
    server_tokens off;

    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}

# Anything else that reaches us (wrong Host, IP address): refuse -----------------
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    access_log /dev/stdout his;
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${HIS_DOMAIN};
    access_log /dev/stdout his;
    keepalive_timeout 30s;
    server_tokens off;

    # TLS ---------------------------------------------------------------------------
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_timeout 1d;
    ssl_session_cache shared:his_tls:10m;
    ssl_session_tickets off;

    # Headers ----------------------------------------------------------------------
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    proxy_hide_header X-Powered-By;
    # The edge owns these; hide the upstream copies so each header appears once.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;

    # Credentials, OTP and token endpoints: tightest rate limit.
    location /api/v1/auth/ {
        limit_req zone=his_auth burst=5 nodelay;
        client_max_body_size 16k;     # credentials and codes are tiny
        proxy_pass http://his_backend;
        include /etc/nginx/proxy_params.conf;
    }

    # Public, unauthenticated: enquiry form and QR verification.
    location /api/v1/public/ {
        limit_req zone=his_public burst=5 nodelay;
        client_max_body_size 32k;
        proxy_pass http://his_backend;
        include /etc/nginx/proxy_params.conf;
    }

    # Patient photo upload is the only large body (backend caps at 5 MB).
    location ~ ^/api/v1/patients/[^/]+/photo$ {
        limit_req zone=his_general burst=10 nodelay;
        client_max_body_size 6m;
        proxy_pass http://his_backend;
        include /etc/nginx/proxy_params.conf;
    }

    # API schema/docs are never published.
    location ~ ^/(docs|redoc|openapi\.json)$ { return 404; }

    location /api/ {
        limit_req zone=his_general burst=40 nodelay;
        client_max_body_size 256k;
        proxy_pass http://his_backend;
        include /etc/nginx/proxy_params.conf;
    }

    location / {
        proxy_pass http://his_frontend;
        include /etc/nginx/proxy_params.conf;
    }
}
